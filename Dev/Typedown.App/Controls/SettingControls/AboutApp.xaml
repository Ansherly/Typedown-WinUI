<UserControl
    x:Class="Typedown.Core.Controls.AboutApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Typedown.Core"
    xmlns:u="using:Typedown.Core.Utilities"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <StackPanel Spacing="8">

        <TextBlock FontWeight="Bold" Text="{u:LocaleString Key=About.AboutApp}"/>

        <StackPanel Margin="2,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0" Text="{x:Bind app:Config.AppName}"/>
                <TextBlock Text="{x:Bind local:AboutApp.GetAppVersion()}"/>
            </StackPanel>
            <TextBlock Text="{u:LocaleString Key=About.Introduction}"/>
        </StackPanel>

        <StackPanel Margin="-12,8,0,0">
            <!-- Opens the bundled third-party component list (see NOTICE.md). -->
            <HyperlinkButton Content="{u:LocaleString Key=About.BasedOnOpenSourceSoftware}" Click="OpenSourceSoftwareButton_Click"/>
            <HyperlinkButton Content="{u:LocaleString Key=About.GithubRepository}" NavigateUri="https://github.com/Ansherly/Typedown-WinUI" />
        </StackPanel>

    </StackPanel>
</UserControl>
